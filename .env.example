# JibonJotno — Environment Variables Template (.env.example)
# Ekhane kokhono asol password ba secret key likhben na.

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/jibonjotno_dev"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY"
CSRF_SECRET="REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_CSRF_KEY"

# Feature Flags [VERIFY-PRO]
COMMERCE_ENABLED="false"
TEST_MODE_BANNER="true"

# Super Admin salted SHA-256 login (never commit real secrets)
ADMIN_EMAIL="mahmudulhm2003@gmail.com"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_SHA256=""
ADMIN_AUTH_SALT=""
NEXT_PUBLIC_ADMIN_AUTH_SALT="jj-public-kdf-v1"

# Optional Git LFS media fallback for the 35k medicines dataset on Vercel
MEDICINES_GITHUB_REPO="mhasnx/jibonjotno"
MEDICINES_GITHUB_REF="main"
MEDICINES_DATASET_URL=""

# Storage Paths
PUBLIC_UPLOAD_DIR="./storage/public-uploads"
PRIVATE_RX_STORAGE_DIR="./storage/private-rx"
